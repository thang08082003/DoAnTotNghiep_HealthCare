rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection - users can read/write their own data
    // Also allow authenticated users to read all users for doctor selection
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null; // Allow reading all users for doctor queries
    }
    
    // Doctors collection - authenticated users can read all doctors
    match /doctors/{doctorId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == doctorId;
    }
    
    // Patients collection - authenticated users can read/write based on user ID
    match /patients/{patientId} {
      allow read, write: if request.auth != null && request.auth.uid == patientId;
    }
    
    // Patient-Doctor assignments - both patient and doctor can read/write
    match /patient_doctor_assignments/{assignmentId} {
      allow read, write: if request.auth != null && 
        (resource.data.patientId == request.auth.uid || 
         resource.data.doctorId == request.auth.uid);
      allow create: if request.auth != null;
    }
    
    // Appointments - both patient and doctor can read/write their appointments
    match /appointments/{appointmentId} {
      allow read, write: if request.auth != null && 
        (resource.data.patientId == request.auth.uid || 
         resource.data.doctorId == request.auth.uid);
      allow create: if request.auth != null;
    }
    
    // Medical records - both patient and doctor can read/write
    match /medical_records/{recordId} {
      allow read, write: if request.auth != null && 
        (resource.data.patientId == request.auth.uid || 
         resource.data.doctorId == request.auth.uid);
      allow create: if request.auth != null;
    }
    
    // Notifications - users can read/write their own notifications
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null && 
        resource.data.userId == request.auth.uid;
      allow create: if request.auth != null;
    }

    // Follow requests between patients and doctors
    // Document ID format: {patientId}_{doctorId}
    match /follow_requests/{requestId} {
      // Only the patient can create a request document
      allow create: if request.auth != null &&
        request.resource.data.patientId == request.auth.uid;

      // Allow reading if the doc id references the current user
      // This works even when the doc does not exist (for transaction get()).
      allow read: if request.auth != null && (
        // Access by docId for direct lookups or non-existent docs
        requestId.matches('^' + request.auth.uid + '_.+') ||
        requestId.matches('.+_' + request.auth.uid + '$') ||
        // Access by document fields for queries (e.g., where doctorId == uid)
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId == request.auth.uid
      );

      // Updates/deletes only allowed for participants on the doc
      allow update, delete: if request.auth != null && (
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId == request.auth.uid
      );
    }

    // Conversations (chat) - only participants can read/write
    // conversationId format: {userA}_{userB}
    function isConvParticipant(convId) {
      return request.auth != null && (
        convId.matches('^' + request.auth.uid + '_.+') ||
        convId.matches('.+_' + request.auth.uid + '$')
      );
    }

    match /conversations/{convId} {
      // Optionally allow creating a conversation doc; messages live in subcollection
      allow read, write: if isConvParticipant(convId);

      match /messages/{messageId} {
        // Allow participants to read messages in their conversation
        allow read: if isConvParticipant(convId);

        // Allow creating messages if the sender is the authenticated user and is a participant
        allow create: if isConvParticipant(convId) && request.resource.data.senderId == request.auth.uid;

        // Allow updates/deletes by participants (e.g., mark as read)
        allow update, delete: if isConvParticipant(convId) && (
          resource.data.senderId == request.auth.uid ||
          resource.data.receiverId == request.auth.uid
        );
      }

      // Doctor orders (chỉ định) subcollection
      function isDoctor(uid) {
        return get(/databases/$(database)/documents/users/$(uid)).data.role == 'doctor';
      }

      match /orders/{orderId} {
        // Participants can read all orders in their conversation
        allow read: if isConvParticipant(convId);

        // Only a doctor participant can create/update orders and doctorId must match the writer
        allow create, update: if isConvParticipant(convId) && isDoctor(request.auth.uid) &&
          request.resource.data.doctorId == request.auth.uid;

        // Optionally allow delete by doctor as well
        allow delete: if isConvParticipant(convId) && isDoctor(request.auth.uid) &&
          resource.data.doctorId == request.auth.uid;
      }
    }
  }
}